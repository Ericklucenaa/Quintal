rules_version = '2';

// Concord Firestore security rules.
//
// Access model:
//   * Servers keep `memberIds` (for queries) and a `roles` map (uid -> role).
//     Membership and roles are checked server-side here, never trusted from
//     the client. Ownership is `ownerId`, not the role string.
//   * Channel messages carry `serverId` so every read/write can be checked
//     against the server's membership and per-channel permissions.
//   * DMs (1-on-1 and groups) live in threads with an explicit participant list.
//   * Voice/screen signaling is only allowed between people in the same call.
//   * Anything not matched below is denied.
//
// Covered by tests in desktop/tests/rules.test.js (Firestore emulator).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    function serverDoc(serverId) {
      return get(docPath('concord_servers', serverId)).data;
    }

    function threadDoc(threadId) {
      return get(docPath('concord_dm_threads', threadId)).data;
    }

    function roleIn(s) {
      return s.roles.get(uid(), null);
    }

    function isMemberOf(s) {
      return signedIn() && uid() in s.memberIds;
    }

    function isOwnerOf(s) {
      return signedIn() && s.ownerId == uid();
    }

    function isAdminOf(s) {
      return isOwnerOf(s) || (isMemberOf(s) && roleIn(s) == 'admin');
    }

    function isModOf(s) {
      return isAdminOf(s) || (isMemberOf(s) && roleIn(s) == 'moderator');
    }

    // Permissões por cargo (bots, Vitrola, sala 3D). Dono e admins têm todas; sem mapa
    // salvo valem os padrões (os mesmos de services/permissions.js).
    function rolePerms(s) {
      return s.get('rolePermissions', {
        'moderator': ['bots.use', 'music.control', 'room.theme', 'room.collective'],
        'member': ['bots.use', 'room.theme', 'room.collective']
      });
    }

    function hasPerm(s, perm) {
      return isAdminOf(s) || (isMemberOf(s) && perm in rolePerms(s).get(roleIn(s), []));
    }

    function botOn(s, botId) {
      return botId in s.get('bots', {});
    }

    function botCfg(s, botId) {
      return s.get('bots', {}).get(botId, {}).get('config', {});
    }

    // Bots que existem no app (o campo `bots` só aceita estes).
    function validBots(b) {
      return b.keys().hasOnly(['vitrola', 'porteiro', 'guarda', 'sorte']);
    }

    // Mensagem de bot: o bot está ligado e a pessoa pode usar bots. O Porteiro posta
    // em nome de quem acabou de entrar, então só precisa estar ligado.
    function botMessageOk(s) {
      return incoming().get('bot', null) == null || (
        incoming().bot is string
        && botOn(s, incoming().bot)
        && (incoming().bot == 'porteiro' || hasPerm(s, 'bots.use'))
        && incoming().get('botCommand', '').size() <= 120
      );
    }

    // Guarda: palavras proibidas, links e excesso de menções (moderadores passam).
    function passesGuard(s) {
      return !botOn(s, 'guarda') || isModOf(s) || (
        (botCfg(s, 'guarda').get('pattern', '') == ''
          || !incoming().content.lower().matches(botCfg(s, 'guarda').get('pattern', '')))
        && (botCfg(s, 'guarda').get('blockLinks', false) != true
          || !incoming().content.lower().matches('(?s).*(https?://|www[.]).*'))
        && incoming().get('mentions', []).size() <= botCfg(s, 'guarda').get('maxMentions', 50)
      );
    }

    function canCreateChannelMessage(s, channelId) {
      return canPostInChannel(s, channelId) && botMessageOk(s) && passesGuard(s);
    }

    // A channel listed in `channelRoles` is only visible to those roles (plus admins).
    function canViewChannel(s, channelId) {
      return isMemberOf(s) && (
        !(channelId in s.get('channelRoles', {}))
        || isAdminOf(s)
        || roleIn(s) in s.channelRoles[channelId]
      );
    }

    // Read-only channels accept posts from moderators and above only.
    function canPostInChannel(s, channelId) {
      return canViewChannel(s, channelId) && (
        s.get('readOnlyChannels', {}).get(channelId, false) != true
        || isModOf(s)
      );
    }

    function isParticipant(t) {
      return signedIn() && uid() in t.participants;
    }

    function otherParticipant(t) {
      return t.participants[0] == uid() ? t.participants[1] : t.participants[0];
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function areFriends(a, b) {
      return exists(docPath('concord_friends', pairId(a, b)))
        && get(docPath('concord_friends', pairId(a, b))).data.status == 'accepted';
    }

    // `target` has blocked `actor`.
    function hasBlocked(target, actor) {
      return exists(docPath('concord_blocks', target))
        && actor in get(docPath('concord_blocks', target)).data.get('blockedIds', []);
    }

    // `target` only accepts DMs from friends.
    function friendsOnlyDMs(target) {
      return exists(docPath('concord_users', target))
        && get(docPath('concord_users', target)).data.get('dmPolicy', 'everyone') == 'friends';
    }

    // Sending to a 1-on-1 conversation: not blocked, and allowed by the other's DM policy.
    function canDirectMessage(t) {
      return t.isGroup == true || (
        !hasBlocked(otherParticipant(t), uid())
        && (!friendsOnlyDMs(otherParticipant(t)) || areFriends(uid(), otherParticipant(t)))
      );
    }

    function canAccessScope(scopeType, scopeId) {
      return (scopeType == 'server' && isMemberOf(serverDoc(scopeId)))
        || (scopeType == 'dm' && isParticipant(threadDoc(scopeId)));
    }

    // Exactly the caller added or removed themselves from list `after` vs `before`.
    function onlyCallerChanged(after, before) {
      return after.toSet().difference(before.toSet()).hasOnly([uid()])
        && before.toSet().difference(after.toSet()).hasOnly([uid()]);
    }

    // A reaction toggle touches one emoji, and only the caller's own entry in it.
    // The client records which emoji it toggled in `lastReaction`.
    function isOwnReactionToggle() {
      return changedKeys().hasOnly(['reactions', 'lastReaction'])
        && incoming().lastReaction.uid == uid()
        && incoming().reactions.diff(resource.data.get('reactions', {})).affectedKeys()
             .hasOnly([incoming().lastReaction.emoji])
        && onlyCallerChanged(
             incoming().reactions.get(incoming().lastReaction.emoji, []),
             resource.data.get('reactions', {}).get(incoming().lastReaction.emoji, []));
    }

    // A poll vote only changes the caller's own entry in `pollVotes`.
    function isOwnPollVote() {
      return changedKeys().hasOnly(['pollVotes'])
        && resource.data.get('poll', null) != null
        && incoming().pollVotes.diff(resource.data.get('pollVotes', {})).affectedKeys().hasOnly([uid()]);
    }

    function presenceOf(userId) {
      return get(docPath('concord_voice_presence', userId)).data;
    }

    // Both users are currently in the same call (`channelId`).
    function inSameCall(a, b, channelId) {
      return exists(docPath('concord_voice_presence', a))
        && exists(docPath('concord_voice_presence', b))
        && presenceOf(a).channelId == channelId
        && presenceOf(b).channelId == channelId;
    }

    // ---------------------------------------------------------------------
    // Users, nicknames, private settings
    // ---------------------------------------------------------------------

    match /concord_users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId && incoming().id == userId
        && incoming().get('bio', '').size() <= 190;
      allow delete: if signedIn() && uid() == userId;
    }

    // Nickname registry (doc id = lowercase nickname). Readable by id before
    // login (username login), never listable, and only the holder can change it.
    match /concord_nicknames/{nickname} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && incoming().userId == uid()
        && nickname == nickname.lower();
      allow update: if signedIn() && resource.data.userId == uid() && incoming().userId == uid();
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    match /concord_blocks/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /concord_read_states/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // Notification preferences (muted channels/servers, per-server level).
    match /concord_user_settings/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // Client error reports (write-only; read with admin credentials).
    match /concord_error_reports/{reportId} {
      allow create: if signedIn()
        && incoming().userId == uid()
        && incoming().message is string && incoming().message.size() <= 2000
        && incoming().get('stack', '').size() <= 8000;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Servers
    // ---------------------------------------------------------------------

    function isValidNewServer() {
      return incoming().ownerId == uid()
        && incoming().memberIds == [uid()]
        && incoming().roles.keys().hasOnly([uid()])
        && incoming().roles[uid()] == 'owner';
    }

    // The invite used to join is valid and its use counter is bumped in the same batch.
    function isUsableInvite(code, serverId) {
      let before = get(docPath('concord_invites', code)).data;
      let after = getAfter(docPath('concord_invites', code)).data;
      return before.serverId == serverId
        && (before.get('expiresAt', null) == null || request.time.toMillis() < before.expiresAt)
        && after.get('uses', 0) == before.get('uses', 0) + 1
        && (before.get('maxUses', null) == null || after.get('uses', 0) <= before.maxUses);
    }

    function isValidJoin(serverId) {
      return !(uid() in resource.data.memberIds)
        && !(uid() in resource.data.get('bannedIds', []))
        && changedKeys().hasOnly(['memberIds', 'roles', 'lastJoinCode', 'updatedAt'])
        && incoming().memberIds.toSet() == resource.data.memberIds.toSet().union([uid()].toSet())
        && incoming().roles.diff(resource.data.roles).affectedKeys() == [uid()].toSet()
        && incoming().roles[uid()] == 'member'
        && isUsableInvite(incoming().lastJoinCode, serverId);
    }

    function isValidLeave() {
      return uid() in resource.data.memberIds
        && resource.data.ownerId != uid()
        && changedKeys().hasOnly(['memberIds', 'roles', 'updatedAt'])
        && incoming().memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
        && incoming().roles.diff(resource.data.roles).affectedKeys() == [uid()].toSet()
        && !(uid() in incoming().roles);
    }

    // Admins may manage everything except ownership; the owner stays a member.
    function isValidAdminEdit() {
      return isAdminOf(resource.data)
        && !changedKeys().hasAny(['ownerId'])
        && resource.data.ownerId in incoming().memberIds
        && incoming().roles[resource.data.ownerId] == 'owner';
    }

    // Owner may also transfer ownership to another member.
    function isValidOwnerEdit() {
      return isOwnerOf(resource.data)
        && incoming().ownerId in incoming().memberIds
        && incoming().roles[incoming().ownerId] == 'owner';
    }

    match /concord_servers/{serverId} {
      allow read: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn() && isValidNewServer();
      allow update: if signedIn() && (
        isValidJoin(serverId)
        || isValidLeave()
        || isValidOwnerEdit()
        || isValidAdminEdit()
        || (isModOf(resource.data) && changedKeys().hasOnly(['mutedIds', 'updatedAt']))
        || (hasPerm(resource.data, 'bots.manage')
          && changedKeys().hasOnly(['bots', 'updatedAt'])
          && validBots(incoming().get('bots', {})))
      );
      allow delete: if isOwnerOf(resource.data);
    }

    // Invite codes: readable by id so anyone with the link can preview/join.
    match /concord_invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && (
        resource.data.creatorId == uid() || isAdminOf(serverDoc(resource.data.serverId))
      );
      allow create: if signedIn()
        && incoming().creatorId == uid()
        && incoming().code == code
        && incoming().get('uses', 0) == 0
        && isMemberOf(serverDoc(incoming().serverId));
      // The only update is the use counter, bumped by the person joining.
      allow update: if signedIn()
        && changedKeys().hasOnly(['uses'])
        && incoming().uses == resource.data.get('uses', 0) + 1
        && !(uid() in serverDoc(resource.data.serverId).memberIds)
        && uid() in getAfter(docPath('concord_servers', resource.data.serverId)).data.memberIds;
      allow delete: if signedIn() && (
        resource.data.creatorId == uid() || isAdminOf(serverDoc(resource.data.serverId))
      );
    }

    // Invites sent directly to a user's inbox.
    match /concord_user_invites/{inviteId} {
      allow read: if signedIn() && (resource.data.receiverId == uid() || resource.data.senderId == uid());
      allow create: if signedIn()
        && incoming().senderId == uid()
        && !hasBlocked(incoming().receiverId, uid())
        && isMemberOf(serverDoc(incoming().serverId))
        && exists(docPath('concord_invites', incoming().code));
      allow update: if signedIn()
        && resource.data.receiverId == uid()
        && changedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn() && (resource.data.receiverId == uid() || resource.data.senderId == uid());
    }

    // Moderation log: written by moderators, read by moderators.
    match /concord_audit/{entryId} {
      allow read: if isModOf(serverDoc(resource.data.serverId));
      allow create: if signedIn()
        && incoming().actorId == uid()
        && isModOf(serverDoc(incoming().serverId));
      allow update, delete: if false;
    }

    // Scheduled events with RSVPs.
    match /concord_events/{eventId} {
      allow read: if signedIn() && isMemberOf(serverDoc(resource.data.serverId));
      allow create: if signedIn()
        && incoming().createdBy == uid()
        && isMemberOf(serverDoc(incoming().serverId));
      allow update: if signedIn() && incoming().serverId == resource.data.serverId && (
        resource.data.createdBy == uid()
        || isModOf(serverDoc(resource.data.serverId))
        || (changedKeys().hasOnly(['rsvps'])
          && isMemberOf(serverDoc(resource.data.serverId))
          && incoming().rsvps.diff(resource.data.get('rsvps', {})).affectedKeys().hasOnly([uid()]))
      );
      allow delete: if signedIn() && (
        resource.data.createdBy == uid() || isModOf(serverDoc(resource.data.serverId))
      );
    }

    // Auto-created voice rooms (from a "create room" lobby channel).
    match /concord_temp_channels/{channelId} {
      allow read: if signedIn() && isMemberOf(serverDoc(resource.data.serverId));
      allow create: if signedIn()
        && incoming().ownerId == uid()
        && isMemberOf(serverDoc(incoming().serverId));
      allow update: if signedIn() && resource.data.ownerId == uid() && changedKeys().hasOnly(['name']);
      // Any member may clean up an empty room.
      allow delete: if signedIn() && isMemberOf(serverDoc(resource.data.serverId));
    }

    // ---------------------------------------------------------------------
    // Channel messages, activity, mentions, typing
    // ---------------------------------------------------------------------

    match /concord_messages/{messageId} {
      allow read: if signedIn() && canViewChannel(serverDoc(resource.data.serverId), resource.data.channelId);

      allow create: if signedIn()
        && incoming().userId == uid()
        && incoming().get('pinned', false) == false
        && incoming().content is string
        && canCreateChannelMessage(serverDoc(incoming().serverId), incoming().channelId);

      allow update: if signedIn() && (
        // Author edits their own text.
        (resource.data.userId == uid()
          && resource.data.get('bot', null) == null
          && changedKeys().hasOnly(['content', 'editedAt', 'mentions', 'mentionEveryone'])
          && passesGuard(serverDoc(resource.data.serverId)))
        // Members toggle their own reactions and poll votes.
        || ((isOwnReactionToggle() || isOwnPollVote())
          && canViewChannel(serverDoc(resource.data.serverId), resource.data.channelId))
        // Moderators pin/unpin.
        || (changedKeys().hasOnly(['pinned', 'pinnedBy', 'pinnedAt'])
          && isModOf(serverDoc(resource.data.serverId)))
      );

      allow delete: if signedIn() && (
        resource.data.userId == uid() || isModOf(serverDoc(resource.data.serverId))
      );
    }

    // Last-activity marker per channel, used for unread indicators.
    match /concord_channel_activity/{channelId} {
      allow read: if signedIn() && isMemberOf(serverDoc(resource.data.serverId));
      allow create: if signedIn()
        && incoming().channelId == channelId
        && canPostInChannel(serverDoc(incoming().serverId), channelId);
      allow update: if signedIn()
        && incoming().serverId == resource.data.serverId
        && incoming().channelId == channelId
        && canPostInChannel(serverDoc(resource.data.serverId), channelId);
    }

    match /concord_mentions/{mentionId} {
      allow read, delete: if signedIn() && resource.data.targetId == uid();
      allow update: if signedIn() && resource.data.targetId == uid() && changedKeys().hasOnly(['read']);
      allow create: if signedIn()
        && incoming().authorId == uid()
        && incoming().get('read', false) == false
        && !hasBlocked(incoming().targetId, uid())
        && isMemberOf(serverDoc(incoming().serverId))
        && incoming().targetId in serverDoc(incoming().serverId).memberIds;
    }

    // Typing indicators (doc id = "<scopeKey>_<uid>"), visible to the scope only.
    match /concord_typing/{typingId} {
      allow read: if signedIn() && canAccessScope(resource.data.scopeType, resource.data.scopeId);
      allow create, update: if signedIn()
        && incoming().userId == uid()
        && typingId == incoming().scopeKey + '_' + uid()
        && canAccessScope(incoming().scopeType, incoming().scopeId);
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    // ---------------------------------------------------------------------
    // Direct messages (1-on-1 and groups)
    // ---------------------------------------------------------------------

    function isValidNewThread(threadId) {
      return uid() in incoming().participants
        && incoming().participants.size() == 2
        && (
          // 1-on-1: id derived from both participants, allowed by the other's settings.
          (incoming().isGroup == false
            && incoming().participants[0] < incoming().participants[1]
            && threadId == 'dm_' + incoming().participants[0] + '_' + incoming().participants[1]
            && canDirectMessage(incoming()))
          // Group: starts with the owner and one friend; more are added one at a time.
          || (incoming().isGroup == true
            && incoming().ownerId == uid()
            && threadId.matches('grp_[A-Za-z0-9_-]+')
            && areFriends(uid(), otherParticipant(incoming()))
            && !hasBlocked(otherParticipant(incoming()), uid()))
        );
    }

    // The group owner removes people, or adds one friend (`lastAddedId`) at a time.
    function isValidGroupOwnerEdit() {
      let added = incoming().participants.toSet().difference(resource.data.participants.toSet());
      return resource.data.isGroup == true
        && resource.data.ownerId == uid()
        && incoming().participants.size() <= 10
        && incoming().ownerId in incoming().participants
        && (
          added.size() == 0
          || (added == [incoming().lastAddedId].toSet()
            && areFriends(uid(), incoming().lastAddedId)
            && !hasBlocked(incoming().lastAddedId, uid()))
        );
    }

    match /concord_dm_threads/{threadId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() && isValidNewThread(threadId);
      allow update: if isParticipant(resource.data) && (
        changedKeys().hasOnly(['lastMessageAt', 'lastMessageBy', 'lastPreview', 'updatedAt'])
        || isValidGroupOwnerEdit()
        // Leaving a group.
        || (resource.data.isGroup == true
          && changedKeys().hasOnly(['participants', 'updatedAt'])
          && incoming().participants.toSet() == resource.data.participants.toSet().difference([uid()].toSet()))
      );
      allow delete: if signedIn() && resource.data.isGroup == true && resource.data.ownerId == uid();
    }

    match /concord_direct_messages/{messageId} {
      allow read: if signedIn() && isParticipant(threadDoc(resource.data.dmId));
      allow create: if signedIn()
        && incoming().senderId == uid()
        && isParticipant(threadDoc(incoming().dmId))
        && canDirectMessage(threadDoc(incoming().dmId));
      allow update: if signedIn() && (
        (resource.data.senderId == uid() && changedKeys().hasOnly(['content', 'editedAt']))
        || ((isOwnReactionToggle() || isOwnPollVote()) && isParticipant(threadDoc(resource.data.dmId)))
      );
      allow delete: if signedIn() && resource.data.senderId == uid();
    }

    // ---------------------------------------------------------------------
    // Friends (doc id = "<smallerUid>_<largerUid>")
    // ---------------------------------------------------------------------

    match /concord_friends/{pairId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && incoming().requesterId == uid()
        && uid() in incoming().participants
        && incoming().participants.size() == 2
        && incoming().participants[0] < incoming().participants[1]
        && pairId == incoming().participants[0] + '_' + incoming().participants[1]
        && incoming().status == 'pending'
        && !hasBlocked(otherParticipant(incoming()), uid());
      allow update: if isParticipant(resource.data)
        && resource.data.status == 'pending'
        && incoming().status == 'accepted'
        && resource.data.requesterId != uid()
        && changedKeys().hasOnly(['status', 'profiles', 'updatedAt']);
      allow delete: if isParticipant(resource.data);
    }

    // ---------------------------------------------------------------------
    // Attachments (chunked files, max 8 MB)
    // ---------------------------------------------------------------------

    match /concord_attachments/{attachmentId} {
      allow read: if signedIn() && canAccessScope(resource.data.scopeType, resource.data.scopeId);
      allow create: if signedIn()
        && incoming().ownerId == uid()
        && incoming().size <= 8 * 1024 * 1024
        && incoming().chunkCount <= 12
        && canAccessScope(incoming().scopeType, incoming().scopeId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /chunks/{chunkId} {
        function parent() {
          return get(/databases/$(database)/documents/concord_attachments/$(attachmentId)).data;
        }
        allow read: if signedIn() && canAccessScope(parent().scopeType, parent().scopeId);
        allow create: if signedIn() && parent().ownerId == uid();
        allow delete: if signedIn() && parent().ownerId == uid();
      }
    }

    // ---------------------------------------------------------------------
    // Voice, screen share and soundboard
    // ---------------------------------------------------------------------

    function canJoinCall(data) {
      return (data.get('serverId', null) != null && isMemberOf(serverDoc(data.serverId)))
        || (data.get('threadId', null) != null && isParticipant(threadDoc(data.threadId)));
    }

    // One presence doc per user (doc id = uid): a server voice channel or a DM call.
    match /concord_voice_presence/{userId} {
      allow read: if signedIn() && canJoinCall(resource.data);
      allow create, update: if signedIn()
        && uid() == userId
        && incoming().userId == uid()
        && canJoinCall(incoming());
      allow delete: if signedIn() && (
        uid() == userId
        || (resource.data.get('serverId', null) != null && isModOf(serverDoc(resource.data.serverId)))
      );
    }

    match /concord_voice_signals/{signalId} {
      allow create: if signedIn()
        && incoming().senderId == uid()
        && inSameCall(uid(), incoming().targetId, incoming().channelId);
      allow read: if signedIn() && resource.data.targetId == uid();
      allow delete: if signedIn() && (resource.data.targetId == uid() || resource.data.senderId == uid());
    }

    match /concord_screen_signals/{signalId} {
      allow create: if signedIn()
        && incoming().fromUserId == uid()
        && inSameCall(uid(), incoming().toUserId, incoming().channelId);
      allow read: if signedIn() && resource.data.toUserId == uid();
      allow delete: if signedIn() && (resource.data.toUserId == uid() || resource.data.fromUserId == uid());
    }

    // Vitrola: o que toca em cada canal de voz (doc id = "<serverId>_<channelId>").
    function musicServer(data) {
      return serverDoc(data.serverId);
    }

    function inVoiceChannel(userId, channelId) {
      return exists(docPath('concord_voice_presence', userId))
        && presenceOf(userId).get('channelId', null) == channelId;
    }

    // A faixa passou do fim (com 4 s de folga): qualquer um com permissão pode avançar.
    function trackOver(data) {
      return data.get('current', null) != null
        && data.current.get('paused', false) == false
        && data.current.get('durationMs', 0) > 0
        && request.time.toMillis() > data.current.startedAt + data.current.durationMs + 4000;
    }

    function validMusicSession(sessionId) {
      return sessionId == incoming().serverId + '_' + incoming().channelId
        && incoming().hostId == uid()
        && incoming().keys().hasOnly(['serverId', 'channelId', 'hostId', 'current', 'updatedAt']);
    }

    match /concord_music/{sessionId} {
      // ler uma sessão que ainda não existe não revela nada (o app escuta antes de tocar)
      allow read: if signedIn() && (resource == null || isMemberOf(musicServer(resource.data)));
      allow create: if signedIn()
        && validMusicSession(sessionId)
        && botOn(musicServer(incoming()), 'vitrola')
        && isMemberOf(musicServer(incoming()))
        && inVoiceChannel(uid(), incoming().channelId);
      allow update: if signedIn()
        && incoming().serverId == resource.data.serverId
        && incoming().channelId == resource.data.channelId
        && incoming().keys().hasOnly(['serverId', 'channelId', 'hostId', 'current', 'updatedAt'])
        && botOn(musicServer(resource.data), 'vitrola')
        && (
          hasPerm(musicServer(resource.data), 'music.control')
          // anfitrião (quem está tocando a fila) ou quem assume quando ele some/a faixa acaba
          || (isMemberOf(musicServer(resource.data))
            && inVoiceChannel(uid(), resource.data.channelId)
            && incoming().hostId == uid()
            && (resource.data.hostId == uid()
              || !inVoiceChannel(resource.data.hostId, resource.data.channelId)
              || trackOver(resource.data)
              || resource.data.get('current', null) == null))
          // quem pediu a música atual pode pulá-la
          || (resource.data.get('current', null) != null
            && resource.data.current.get('addedBy', '') == uid()
            && inVoiceChannel(uid(), resource.data.channelId)
            && changedKeys().hasOnly(['current', 'hostId', 'updatedAt'])
            && incoming().hostId == uid())
        );
      allow delete: if signedIn() && hasPerm(musicServer(resource.data), 'music.control');
    }

    match /concord_music_queue/{itemId} {
      allow read: if signedIn() && isMemberOf(musicServer(resource.data));
      allow create: if signedIn()
        && incoming().id == itemId
        && incoming().addedBy == uid()
        && incoming().sessionId == incoming().serverId + '_' + incoming().channelId
        && incoming().kind in ['youtube', 'spotify']
        && incoming().ref is string && incoming().ref.size() <= 80
        && incoming().get('title', '').size() <= 200
        && botOn(musicServer(incoming()), 'vitrola')
        && isMemberOf(musicServer(incoming()));
      allow update: if signedIn()
        && changedKeys().hasOnly(['order'])
        && hasPerm(musicServer(resource.data), 'music.control');
      // Sai da fila: quem pediu, quem controla, ou quem começa a tocá-la (mesma transação).
      allow delete: if signedIn() && (
        resource.data.addedBy == uid()
        || hasPerm(musicServer(resource.data), 'music.control')
        || (isMemberOf(musicServer(resource.data))
          && getAfter(docPath('concord_music', resource.data.sessionId)).data.get('current', {}).get('queueId', '') == itemId)
      );
    }

    match /concord_soundboard/{soundId} {
      allow read: if signedIn() && isMemberOf(serverDoc(resource.data.serverId));
      allow create: if signedIn()
        && incoming().userId == uid()
        && isMemberOf(serverDoc(incoming().serverId));
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    // App configuration (e.g. TURN relay credentials): readable by signed-in
    // users, written only with admin credentials (scripts/set-turn.mjs).
    match /concord_app_config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Auto-update manifest: public read, never client-writable. It is
    // published with admin credentials by scripts/publish-release.mjs.
    // ---------------------------------------------------------------------

    match /concord_app_version/{versionId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
